										<h4 class="h6 text-white">Monday - Friday</h4>
										<p class="mb-0 text-white display-30">8:00 AM - 5:00 PM</p>
									</div>
								</li>
								<li>
									<i class="ti-time text-white"></i>
									<div>
										<h4 class="h6 text-white">Saturday</h4>
