<body>
	<div class="main-wrapper">
		<!-- HEADER
		================================================== -->
		<header class="header-style1">
			<div class="navbar-default">
				<div class="menu_area alt-font bg-secondary">
					<div class="container">
						<div class="col-lg-12">
							<nav class="navbar navbar-expand-lg navbar-light p-0">

								<div class="navbar-toggler bg-secondary"></div>

								<!-- start menu area -->
								<ul class="navbar-nav me-auto" id="nav" style="display: none;">
									<li><a asp-controller="Main" asp-action="Home2">Home</a></li>

									<li>
										<a href="#!">Services</a>
									</li>
									<li>
										<a asp-controller="Products" asp-action="mealPlan">My Meals</a>

									</li>
									<li>
										<a asp-controller="Products" asp-action="shop">shop</a>

									</li>
									
										@if (!string.IsNullOrEmpty(Context.Session.GetString("Email")))
										{
									<li>
											<a asp-controller="Main" asp-action="ourDoctors">Doctors</a>
									</li>
										}
									<li>
										<a asp-controller="Main" asp-action="About">About us</a>
									</li>
									<li>
										<a asp-controller="Main" asp-action="contact">Contact</a>
									</li>
								</ul>
								<!-- end menu area -->
								<!-- start attribute navigation -->
								<div class="attr-nav align-items-lg-center ms-auto">
									<ul>
										<li class="cart">
											<a asp-controller="Products" asp-action="cart">
												<i class="fas fa-shopping-cart text-white"></i>
											</a>
										</li>

										@if (!string.IsNullOrEmpty(Context.Session.GetString("Email")))
										{
											<li class="profile">
												<a asp-controller="user" asp-action="profile"><i class="fas fa-user text-white"></i></a>
											</li>
											<li class="d-none d-xl-inline-block">
												<a asp-controller="user" asp-action="Logout" class="butn white-hover sm">Logout</a>
											</li>
										}
										else
										{
											<li class="d-none d-xl-inline-block">
												<a asp-controller="user" asp-action="signIn" class="butn white-hover sm">Login</a>
											</li>
										}
									</ul>
								</div>
								<!-- end attribute navigation -->
							</nav>
						</div>
					</div>
				</div>
			</div>
		</header>
	</div>
	<main role="main">
		@RenderBody()
	</main>

	<div>
