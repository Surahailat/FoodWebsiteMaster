@inject MyDbContext _context
@{
	var sessionUserId = Context.Session.GetInt32("UserId");
	bool hasSubscription = false;

	if (sessionUserId != null)
	{
		var now = DateTime.Now;
		hasSubscription = _context.UserSubscribes
			.Any(us => us.UserId == sessionUserId
								&& us.StartDate <= now
								&& us.EndDate >= now);
	}
}


