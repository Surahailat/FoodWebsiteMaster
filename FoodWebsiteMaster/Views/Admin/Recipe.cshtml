@model IEnumerable<FoodWebsiteMaster.Models.Recipe>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

@{
	ViewData["Title"] = "Recipe";
	Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class=" flex-grow-1 overflow-y-lg-auto">
	<!-- Header -->
	<header class="bg-surface-primary border-bottom pt-6">
		<div class="container-fluid">
			<div class="mb-npx">
				<div class="row align-items-center">
					<div class="col-sm-6 col-12 mb-4 mb-sm-0">
					</div>
				</div>
			</div>
		</div>
	</header>

	<div class="card shadow border-0 mb-7">

		<div class="table-responsive">
			<table class="table table-hover table-nowrap">
				<thead class="thead-light">
					<tr>
						<th scope="col">Name</th>
						<th scope="col">Type</th>
						<th scope="col">Serving Size</th>
						<th scope="col">Ingredients</th>
						<th scope="col">Directions</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model)
					{


						<tr>
							<td>
								<img alt="@item.Name" src="@item.ImageUrl" class="avatar avatar-sm rounded-circle me-2">
								<a class="text-heading font-semibold">
									@item.Name
								</a>
								@item.Name
							</td>
							<td>
								@item.Type
							</td>
							<td>
								@item.ServingSize
							</td>
							<td>
								<a class="btn btn-sm btn-secondary" data-bs-toggle="modal" data-bs-target="#ingredientsModal-@item.Id">
									Ingredients
								</a>
							</td>
							<td>
								<a class="btn btn-sm btn-secondary" data-bs-toggle="modal" data-bs-target="#directionsModal-@item.Id">
									Directions
								</a>
							</td>
							<td class="text-end">
								<a class="btn btn-sm btn-neutral" data-bs-toggle="modal" data-bs-target="#userModal-@item.Id">View</a>
								<a class="btn d-inline-flex btn-sm btn-neutral border-base mx-1" asp-action="EditRecipes" asp-route-id="@item.Id">
									<i class="bi bi-pencil me-1"></i> Edit
								</a>
								<form asp-action="DeleteRecipes" asp-route-id="@item.Id" method="post" style="display:inline">
									<button type="submit" class="btn btn-sm btn-square btn-neutral text-danger-hover">
										<i class="bi bi-trash"></i>
									</button>
								</form>
							</td>
						</tr>
						<!-- المودال الخاص بهذا اليوزر -->
						<div class="modal fade" id="ingredientsModal-@item.Id" tabindex="-1" aria-labelledby="ingredientsModalLabel-@item.Id" aria-hidden="true">
							<div class="modal-dialog modal-dialog-centered modal-md">
								<div class="modal-content">
									<div class="modal-header">
										<h5 class="modal-title" id="ingredientsModalLabel-@item.Id">Ingredients for @item.Name</h5>
										<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
									</div>
									<div class="modal-body">
										@if (item.Ingredients.Any())
										{
											<ul class="list-group">
												@foreach (var ing in item.Ingredients)
												{
													<li class="list-group-item">@ing.IngredientText</li>
												}
											</ul>
										}
										else
										{
											<p class="text-muted">No ingredients listed for this recipe.</p>
										}
									</div>
								</div>
							</div>
						</div>
						<div class="modal fade" id="userModal-@item.Id" tabindex="-1" aria-labelledby="userModalLabel-@item.Id" aria-hidden="true">
							<div class="modal-dialog modal-lg">
								<div class="modal-content">
									<div class="modal-header">
										<h5 class="modal-title" id="userModalLabel-@item.Id">Recipe Information</h5>
										<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
									</div>
									<div class="modal-body">
										<div class="mb-2"><strong>Name:</strong> @item.Name</div>
										<div class="mb-2"><strong>Type:</strong> @item.Type</div>
										<div class="mb-2"><strong>Serving Size:</strong> @item.ServingSize</div>
										<div class="mb-2"><strong>Calories Total:</strong> @item.CaloriesTotal</div>
										<div class="mb-2"><strong>Carbohydrate:</strong> @item.Carbohydrate</div>
										<div class="mb-2"><strong>Total Fat:</strong> @item.TotalFat</div>
										<div class="mb-2"><strong>Protein:</strong> @item.Protein</div>
										<div class="mb-2"><strong>Protein:</strong> @item.Protein</div>

									</div>
								</div>
							</div>
						</div>
						<div class="modal fade" id="directionsModal-@item.Id" tabindex="-1" aria-labelledby="directionsModalLabel-@item.Id" aria-hidden="true">
							<div class="modal-dialog modal-dialog-centered modal-md">
								<div class="modal-content">
									<div class="modal-header">
										<h5 class="modal-title" id="directionsModalLabel-@item.Id">Directions for @item.Name</h5>
										<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
									</div>
									<div class="modal-body">
										@if (item.Directions.Any())
										{
											<ol class="list-group list-group-numbered">
												@foreach (var dir in item.Directions.OrderBy(d => d.StepNumber))
												{
													<li class="list-group-item">@dir.DirectionText</li>
												}
											</ol>
										}
										else
										{
											<p class="text-muted">No directions listed for this recipe.</p>
										}
									</div>
								</div>
							</div>
						</div>
					}
				</tbody>
			</table>
		</div>

	</div>
</div>
