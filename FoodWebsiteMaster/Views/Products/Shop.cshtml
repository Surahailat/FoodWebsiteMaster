@model IEnumerable<FoodWebsiteMaster.Models.Product>

@{
	ViewData["Title"] = "Shop";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>

	<link rel="stylesheet" href="~/css/style.css">
	<link rel="stylesheet" href="~/css/colors/green.css" id="colors">
	<style>
		.product-disabled {
			position: relative;
			pointer-events: none;
		}

		.image-disabled {
			filter: grayscale(100%) brightness(70%);
			opacity: 0.6;
			width: 100%;
			height: auto;
			display: block;
		}

		.badge-outofstock {
			position: absolute;
			top: 10px;
			left: 10px;
			background-color: #dc3545;
			color: white;
			padding: 5px 10px;
			font-weight: bold;
			border-radius: 5px;
			z-index: 10;
			font-size: 14px;
		}

		.product-info-disabled {
			text-align: center;
			color: #999;
			pointer-events: none;
		}


	</style>

</head>

<body>
	<!-- PAGE TITLE
	================================================== -->
	<section class="page-title-section bg-img cover-background" data-overlay-dark="55" data-background="https://lifestyle.websitelayout.net/img/bg/bg-03.jpg">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<h1>Shop</h1>
					<div class="breadcrumb">
						<ul>
							<li><a asp-action="Home2" asp-controller="Main">Home</a></li>
							<li><a href="#!">Shop</a></li>
						</ul>
					</div>
				</div>
			</div>
		</div>
		<div class="bg-transparent border-width-2 border-solid border-secondary p-3 d-sm-inline-block rounded-circle position-absolute bottom-10 left-5 ani-top-bottom d-none z-index-3"></div>
		<div class="bg-secondary p-1-6 d-lg-block rounded-circle position-absolute top-25 right-25 ani-top-bottom d-none z-index-3"></div>
		<div class="bg-white p-2 d-sm-inline-block rounded-circle position-absolute top-40 left-25 ani-left-right d-none z-index-3"></div>
	</section>
	<!-- Wrapper -->
	<div id="wrapper" style="padding: 60px;">





		<!-- Content
		================================================== -->
		<div class="container">

			<!-- Products -->
			<div class="twelve columns left-sidebar-class" style="right: auto;float: none;">

				<!-- Ordering -->
				<form method="get" asp-action="Shop" class="ordering" style="display: flex; justify-content: center;">
					<select name="sortOrder" onchange="this.form.submit()" style="padding: 9px; height: 49.5px;" class="chosen-select-no-single">
						<option value="">Default Sorting</option>
						<option value="az">Sort A to Z</option>
						<option value="za">Sort Z to A</option>
						<option value="price">Sort by Price: Low to High</option>
						<option value="price-desc">Sort by Price: High to Low</option>
					</select>
					<!-- Sidebar
					================================================== -->
					<div class="four columns">

						<!-- Search Form -->
						<div class="widget search-form">
							<nav class="search">
								<button type="submit" style="height: 49.5px;"><i class="fa fa-search"></i></button>
								<input class="search-field" name="searchString" type="text" placeholder="Search for products" value="@Context.Request.Query["searchString"]" style="width: auto;" />
							</nav>
							<div class="clearfix"></div>
						</div>
					</div>
				</form>



				<div class="clearfix"></div>

				@foreach (var item in Model)
				{
					var isOutOfStock = item.StockQuantity == 0;

					<div class="four shop columns">
						<figure class="product">
							@if (isOutOfStock)
							{
								<div class="mediaholder product-disabled">
									<img src="@item.Image" alt="@item.Name" class="image-disabled" />
									<span class="badge-outofstock">Out of Stock</span>
								</div>

								<div class="product-info-disabled">
									<h5>@item.Name</h5>
									<span class="product-price" style="color: black;">@item.Price JD</span>
								</div>
							}
							else
							{
								<div class="mediaholder">
									<a href="/Products/singleProduct/@item.Id">
										<img src="@item.Image" alt="@item.Name" />
									</a>
									<a asp-controller="Products" asp-action="AddToCart" asp-route-id="@item.Id" class="product-button">
										<i class="fa fa-shopping-cart"></i>
									</a>
								</div>

								<a href="/Products/singleProduct/@item.Id">
									<section>
										<h5>@item.Name</h5>
										<span class="product-price" style="color: black;">@item.Price JD</span>
									</section>
								</a>
							}
						</figure>
					</div>
				}




				<div class="clearfix"></div>
				<div class="margin-top-40"></div>

				<!-- Pagination -->
				<div class="pagination-container masonry">
					<nav class="pagination">
						<ul>
							<li><a href="#" class="current-page">1</a></li>
							<li><a href="#">2</a></li>
							<li><a href="#">3</a></li>
						</ul>
					</nav>

					<nav class="pagination-next-prev">
						<ul>
							<li><a href="#" class="prev"></a></li>
							<li><a href="#" class="next"></a></li>
						</ul>
					</nav>
				</div>

			</div>
		</div>
		<!-- Container / End -->


		<div class="margin-top-5"></div>

	</div>




	<!-- Java Script
	================================================== -->
	<script src="~/scripts/jquery-1.11.0.min.js"></script>
	<script src="~/scripts/jquery-migrate-1.2.1.min.js"></script>
	<script src="~/scripts/jquery.superfish.js"></script>
	<script src="~/scripts/jquery.royalslider.min.js"></script>
	<script src="~/scripts/responsive-nav.js"></script>
	<script src="~/scripts/hoverIntent.js"></script>
	<script src="~/scripts/isotope.pkgd.min.js"></script>
	<script src="~/scripts/chosen.jquery.min.js"></script>
	<script src="~/scripts/jquery.tooltips.min.js"></script>
	<script src="~/scripts/jquery.magnific-popup.min.js"></script>
	<script src="~/scripts/jquery.pricefilter.js"></script>
	<script src="~/scripts/custom.js"></script>



</body>
