@model FoodWebsiteMaster.Models.Product

@{
    ViewData["Title"] = "singleProduct";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
	<link rel="stylesheet" href="~/css/style.css">
	<link rel="stylesheet" href="~/css/colors/green.css" id="colors">

</head>

<!-- PAGE TITLE
================================================== -->
<section class="page-title-section bg-img cover-background" data-overlay-dark="55" data-background="https://lifestyle.websitelayout.net/img/bg/bg-03.jpg">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<h1>product Details</h1>
				<div class="breadcrumb">
					<ul>
						<li><a asp-action="Home2" asp-controller="Main">Home</a></li>
						<li><a href="#!">product Details</a></li>
					</ul>
				</div>
			</div>
		</div>
	</div>
	<div class="bg-transparent border-width-2 border-solid border-secondary p-3 d-sm-inline-block rounded-circle position-absolute bottom-10 left-5 ani-top-bottom d-none z-index-3"></div>
	<div class="bg-secondary p-1-6 d-lg-block rounded-circle position-absolute top-25 right-25 ani-top-bottom d-none z-index-3"></div>
	<div class="bg-white p-2 d-sm-inline-block rounded-circle position-absolute top-40 left-25 ani-left-right d-none z-index-3"></div>
</section>

<div class="container" style="padding-top: 5%;">

	<!-- Slider
	================================================== -->
	<div class="eight columns">
		<!-- Slider -->
		<div class="productSlider rsDefault">
			<img class="rsImg" style="width: 100%;height: 440px;" src="@Model.Image" alt="@Model.Name" />
		</div>
		<div class="clearfix"></div>
	</div>


	<!-- Content
	================================================== -->
	<div class="eight columns">
		<div class="product-page">

			<!-- Headline -->
			<section class="title">
				<h2>@Model.Name</h2>
				<span class="product-price" style="color:red;">@Model.Price</span>
				@* <span class="product-price">@Model.StockQuantity</span> *@

			</section>

			<!-- Text Parapgraph -->
			<section>
				<p class="margin-reset">@Model.Description</p>

			</section>


			<section class="linking">


				<form asp-controller="Products" asp-action="AddNumCart" asp-route-id="@Model.Id" method="post">

					<!-- التحكم بالكمية -->
					<div style="display: flex; align-items: center; gap: 10px; margin-bottom: 15px;">
						<div class="qtyminus" onclick="changeQty(-1)"></div>
						<input type="text" name="quantity" value="1" class="qty" min="1" max="@Model.StockQuantity" style="height: 40px;" />
						<div class="qtyplus" onclick="changeQty(1)"></div>
					</div>

					<!-- الزر في سطر جديد -->
					<div>
						<button type="submit" class="button adc color" style="border: none;"><a class="button adc color" style="margin-left: auto;">Add to Cart</a></button>
					</div>

				</form>


				<div class="clearfix"></div>

			</section>

		</div>
	</div>

</div>


<div class="clearfix"></div>
<div class="margin-top-30"></div>


<div class="container">
	<div class="sixteen columns">
		<!-- Tabs Navigation -->
		<ul class="tabs-nav">
			<li class="active"><a href="#tab1">Item Description</a></li>
		</ul>

		<!-- Tabs Content -->
		<div class="tabs-container">

			<div class="tab-content" id="tab1">
				<p>@Model.Description</p>
			</div>


		</div>
	</div>
</div>



<!-- Related Products -->
<div class="container margin-top-5">

	<!-- Headline -->
	<div class="sixteen columns">
		<h3 class="headline">Related Products</h3>
		<span class="line margin-bottom-0"></span>
	</div>

	<!-- Products -->
	<div class="products">

		<!-- Product #3 -->
		<div class="four columns">
			<figure class="product">

				<div class="mediaholder">
					<a href="product-page.html">
						<img alt="" src="images/shop_item_03.jpg" />
					</a>
					<a href="#" class="product-button"><i class="fa fa-shopping-cart"></i></a>
				</div>

				<a href="product-page.html">
					<section>
						<span class="product-category">Spices</span>
						<h5>Chilli Powder</h5>
						<span class="product-price">$2.99</span>
					</section>
				</a>
			</figure>
		</div>

		<!-- Product #4 -->
		<div class="four columns">
			<figure class="product">

				<div class="mediaholder">
					<a href="product-page.html">
						<img alt="" src="images/shop_item_04.jpg" />
					</a>
					<a href="#" class="product-button"><i class="fa fa-shopping-cart"></i></a>
				</div>

				<a href="product-page.html">
					<section>
						<span class="product-category">Spices</span>
						<h5>Black Peppercorns</h5>
						<span class="product-price">$2.99</span>
					</section>
				</a>
			</figure>
		</div>

		<!-- Product #5 -->
		<div class="four columns">
			<figure class="product">

				<div class="mediaholder">
					<a href="product-page.html">
						<img alt="" src="images/shop_item_05.jpg" />
					</a>
					<a href="#" class="product-button"><i class="fa fa-shopping-cart"></i></a>
				</div>

				<a href="product-page.html">
					<section>
						<span class="product-category">Spices</span>
						<h5>Cumin Seeds</h5>
						<span class="product-price">$2.99</span>
					</section>
				</a>
			</figure>
		</div>

		<!-- Product #6 -->
		<div class="four columns">
			<figure class="product">

				<div class="mediaholder">
					<a href="product-page.html">
						<img alt="" src="images/shop_item_06.jpg" />
					</a>
					<a class="product-button"><i class="fa fa-shopping-cart"></i></a>
				</div>

				<a href="product-page.html">
					<section>
						<span class="product-category">Spices</span>
						<h5>Garlic Granules</h5>
