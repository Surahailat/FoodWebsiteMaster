		</div>

	</div>
</div>

<div class="margin-top-50"></div>


<!-- Wrapper / End -->
<script>
	function changeQty(change) {
		const input = document.querySelector(".qty");
		let value = parseInt(input.value) || 1;
		const max = parseInt(input.max) || 999;

		value += change;
		if (value < 1) value = 1;
		if (value > max) value = max;

		input.value = value;
	}
</script>
