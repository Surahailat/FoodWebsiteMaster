@model FoodWebsiteMaster.Models.User

@{
    ViewData["Title"] = "Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .payment-section {
        padding: 50px 0;
        background-color: #f9f9f9;
    }

    .container4 {
        max-width: 800px;
        margin: 0 auto;
        background-color: #fff;
        padding: 40px 30px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .payment-section h3 {
        font-size: 24px;
        color: #333;
        font-weight: 600;
        border-left: 5px solid #00bfa6;
        padding-left: 15px;
    }

    .form-label {
        font-weight: 500;
        color: #555;
    }

    .form-control {
        border-radius: 8px;
        border: 1px solid #ccc;
        padding: 10px;
        transition: border-color 0.3s ease;
    }

        .form-control:focus {
            border-color: #00bfa6;
            box-shadow: 0 0 0 3px rgba(0,191,166,0.1);
        }

    .payment-tab {
        margin-bottom: 20px;
        padding: 15px 20px;
        border: 1px solid #ddd;
        border-radius: 10px;
        background-color: #fcfcfc;
    }

    .payment-tab-content {
        margin-top: 10px;
        padding-left: 20px;
        color: #444;
    }

    .payment-logo {
        height: 24px;
        margin-left: 10px;
        vertical-align: middle;
    }

    .button11 {
        display: inline-block;
        margin-top: 30px;
        background-color: #00bfa6;
        color: white;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 0.3s ease;
        text-align: center;
    }

        .button11:hover {
            background-color: #009e8a;
        }

</style>

<section class="payment-section">
    <form asp-action="Payment" method="post">
        <div class="container4">
            <h3 class="mb-4">Personal Details</h3>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="Name" class="form-label">Name</label>
                    <input type="text" class="form-control" id="Name" name="Name" value="@Model.Username" readonly>
                </div>
                <div class="col-md-6">
                    <label for="email" class="form-label">E-Mail Address</label>
                    <input type="email" class="form-control" id="email" name="Email" value="@Model.Email" readonly>
                </div>
                <div class="col-md-6">
                    <label for="City" class="form-label">City</label>
                    <input type="text" class="form-control" id="City" name="City" value="@Model.City" readonly>
                </div>
                <div class="col-md-6">
                    <label for="phone" class="form-label">Phone</label>
                    <input type="text" class="form-control" id="phone" name="Phone" value="@Model.Phone" readonly>
                </div>
            </div>

            <h3 class="mt-5 mb-4" style="padding-top: 2%;">Payment Method</h3>
            <div>
                <!-- Cash on Delivery Option -->
                <div class="payment-tab">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="paymentMethod" id="cod" value="cod" checked>
                        <label class="form-check-label" for="cod">Cash on Delivery</label>
                    </div>
                    <div class="payment-tab-content" id="cod-content">
                        <div class="row g-3 mt-3">
                            <div class="col-md-6">
                                <label for="address" class="form-label">Address</label>
                                <input type="text" class="form-control" id="address" name="Address" placeholder="123 Main St">
                            </div>
                            <div class="col-md-6">
                                <label for="city" class="form-label">City</label>
                                <input type="text" class="form-control" id="city" name="City" placeholder="Amman">
                            </div>
                            <div class="col-md-6">
                                <label for="postalCode" class="form-label">Apartment Number</label>
                                <input type="text" class="form-control" id="postalCode" name="ApartmentNumber" placeholder="1111">
                            </div>
                            <div class="col-md-6">
                                <label for="phone2" class="form-label">Phone Number</label>
                                <input type="text" class="form-control" id="phone2" name="Phone" placeholder="0791234567">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Credit Card Option -->
                <div class="payment-tab">
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="radio" name="paymentMethod" id="creditCard" value="creditCard">
                        <label class="form-check-label" for="creditCard">Credit / Debit Card</label>
                    </div>
                    <div class="payment-tab-content" id="creditCard-content" style="display: none;">
                        <div class="row g-3 mt-3">
                            <div class="col-md-6">
                                <label for="nameOnCard" class="form-label">Name on Card</label>
                                <input type="text" class="form-control" id="nameOnCard" name="NameOnCard">
                            </div>
                            <div class="col-md-6">
                                <label for="cardNumber" class="form-label">Card Number</label>
                                <input type="text" class="form-control" id="cardNumber" name="CardNumber" placeholder="1234 5678 9876 5432">
                            </div>
                            <div class="col-md-4">
                                <label for="expiryMonth" class="form-label">Expiry Month</label>
                                <input type="text" class="form-control" id="expiryMonth" name="ExpiryCard" placeholder="MM">
                            </div>
                            <div class="col-md-4">
                                <label for="expiryYear" class="form-label">Expiry Year</label>
                                <input type="text" class="form-control" id="expiryYear" name="ExpiryCard" placeholder="YY">
                            </div>
                            <div class="col-md-4">
                                <label for="cvv" class="form-label">CVV</label>
                                <input type="text" class="form-control" id="cvv" name="Cvv">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <button type="submit" class="button11 mt-4">Confirm and Pay</button>
        </div>
    </form>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const codRadio = document.getElementById("cod");
        const cardRadio = document.getElementById("creditCard");
        const codContent = document.getElementById("cod-content");
        const cardContent = document.getElementById("creditCard-content");

        function togglePaymentContent() {
            if (codRadio.checked) {
                codContent.style.display = "block";
                cardContent.style.display = "none";
            } else if (cardRadio.checked) {
                codContent.style.display = "none";
                cardContent.style.display = "block";
            }
        }

        codRadio.addEventListener("change", togglePaymentContent);
        cardRadio.addEventListener("change", togglePaymentContent);

        // Initial toggle on page load
        togglePaymentContent();
    });
</script>



