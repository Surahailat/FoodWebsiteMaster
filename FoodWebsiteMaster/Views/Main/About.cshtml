<!-- PAGE TITLE
================================================== -->
<section class="page-title-section bg-img cover-background" data-overlay-dark="55" data-background="https://lifestyle.websitelayout.net/img/bg/bg-03.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <h1>About Us</h1>
                <div class="breadcrumb">
                    <ul>
                        <li><a href="https://lifestyle.websitelayout.net/index.html">Home</a></li>
                        <li><a href="#!">About Us</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="bg-transparent border-width-2 border-solid border-secondary p-3 d-sm-inline-block rounded-circle position-absolute bottom-10 left-5 ani-top-bottom d-none z-index-3"></div>
    <div class="bg-secondary p-1-6 d-lg-block rounded-circle position-absolute top-25 right-25 ani-top-bottom d-none z-index-3"></div>
    <div class="bg-white p-2 d-sm-inline-block rounded-circle position-absolute top-40 left-25 ani-left-right d-none z-index-3"></div>
</section>

<!-- ABOUTUS
================================================== -->
<section class="about-section position-relative pb-0">
    <div class="container">
        <div class="row align-items-center mt-n1-6">
            <div class="col-md-6 z-index-9 mt-1-6">
                <div class="mb-0 mb-md-3">
                    <span class="title-font display-25 text-capitalize font-weight-800 text-secondary">About Us</span>
                    <h2 class="display-25 display-sm-20 display-xl-9 font-weight-500 text-white mb-0">We suggest using nutrition to fend off sickness.</h2>
                </div>
            </div>
            <div class="col-md-6 mt-1-6">
                <div class="d-flex justify-content-md-end ms-2 ms-md-0">
                    <div class="d-flex justify-content-center align-items-center position-relative">
                        <div class="flex-shrink-0 display-20 display-sm-15 display-lg-5 fw-bold counter-count">
                            <span class="countup">25</span><span class="customer-services">k</span>
                        </div>
                        <div class="flex-grow-1 ms-4 text-start">
                            <h4 class="h6 mb-0 text-secondary display-28 display-sm-25 display-md-23 display-xl-18 fw-bolder">Happy <br>Customers</h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="position-relative z-index-9 video-about mt-3">
                <div class="p-0">
                    <img src="/img/content/y6pv669l.png" class="border-radius-10" alt="...">
                </div>
                <div class="story-video video-column position-absolute top-50 start-50 translate-middle">
                    <a class="video video_btn" href="https://www.youtube.com/watch?v=bREPaPWc2zI">
                        <i class="fas fa-play text-center"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="bg-primary p-2-0 rounded-circle position-absolute bottom-5 right-10 z-index-3 d-none d-md-block"></div>
        <div class="bg-secondary p-3 d-sm-inline-block rounded-circle position-absolute bottom-5 right-10 z-index-3 ani-left-right d-none"></div>
        <img src="https://lifestyle.websitelayout.net/img/content/animation5.png" class="position-absolute top-30 top-md-5 left-60 left-md-30 ani-left-right d-none d-sm-block" alt="...">
    </div>
</section>

<!-- TEAM
================================================== -->
<section class="overflow-visible team-section">
    <div class="container">
        <div class="row g-xxl-5 mt-n1-9 align-items-center">
            <div class="col-lg-3 mt-1-9">
                <div class="section-heading contact-data text-start pe-lg-4">
                    <span class="title-font text-primary display-25 display-md-23 d-block mb-1">Our Doctors</span>
                    <h2 class="fw-bolder">Specialized in Diabetes & Hypertension Care</h2>
                    <p class="mb-3 mb-md-4">
                        Our expert dietitians work closely with patients to manage and monitor diabetes and high blood pressure through personalized nutrition plans. We focus on preventive care and long-term health improvement through science-based dietary guidance.
                    </p>
                    <a href="https://lifestyle.websitelayout.net/our-team.html" class="butn-style01 secondary"><span>Show All</span></a>
                </div>
            </div>
            <div class="col-lg-9 mt-1-9">
                <div class="team-carousel owl-carousel owl-theme">
                    @foreach (var doctor in Model)
                    {
                        <div class="m-2">
                            <div class="card card-style5 border-0 border-radius-10">
                                <div class="card-image position-relative">
                                    <div class="card-icons">
                                        <span class="card-icon ti-plus"></span>
                                     
                                        <a href="#!" class="card-icon fab fa-instagram"></a>
                                    </div>
                                    <img src="@doctor.ProfileImage" alt="@doctor.Name">
                                </div>
                                <div class="card-body text-center p-3">
                                    <h3 class="h4 mb-1"><a>@doctor.Name</a></h3>
                                    <p class="mb-0">@doctor.Position</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="bg-transparent border-width-2 border-solid border-secondary p-1-9 d-sm-inline-block rounded-circle position-absolute bottom-10 right-5 ani-top-bottom d-none"></div>
</section>

