@* @model FoodWebsiteMaster.Models.User *@
@model RegisterViewModel
@section Scripts {
	@await Html.PartialAsync("_ValidationScriptsPartial")
}

<link href="/css/signin.css" rel="stylesheet">

<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.5/font/bootstrap-icons.min.css" rel="stylesheet">

@{
	Layout = null;
}
<style>
	.text-danger {
		color: red;
		font-size: 0.875rem; /* You can adjust the size */
	}

</style>
<body>
	<div class="container">
		<div class="forms-container">
			<div class="signin-signup">
				<form class="sign-in-form" asp-action="signIn" method="post">
					<h2 class="title">Sign in</h2>
					<div class="input-field">
						<i class="fas fa-user"></i>
						<input type="email" placeholder="Email" asp-for="Email" required />
					</div>
					<span asp-validation-for="Email" class="text-danger"></span>  <!-- Error message for Email -->
					<div class="input-field">
						<i class="fas fa-lock"></i>
						<input type="password" placeholder="Password" asp-for="Password" required />
					</div>
					<span asp-validation-for="Password" class="text-danger"></span>  <!-- Error message for Password -->
					<input type="submit" value="Login" class="btn solid" />
					<p class="social-text">Or Sign in with social platforms</p>
					<div class="social-media">
						<a href="#" class="social-icon">
							<i class="bi bi-facebook"></i>
						</a>
						<a href="#" class="social-icon">
							<i class="bi bi-google"></i>
						</a>
						<a href="#" class="social-icon">
							<i class="bi bi-apple"></i>
						</a>
					</div>
				</form>
				<form class="sign-up-form" asp-action="Register" method="post">
					<h2 class="title">Sign up</h2>

					<div class="input-field">
						<i class="fas fa-user"></i>
						<input type="text" placeholder="Username" asp-for="Username" />
					</div>
					<span asp-validation-for="Username" class="text-danger"></span>

					<div class="input-field">
						<i class="fas fa-phone"></i>
						<input type="tel" placeholder="Phone" asp-for="Phone" required pattern="^(\+962|0)?7[7-9][0-9]{7}$" />
					</div>
					<span asp-validation-for="Phone" class="text-danger"></span>

					<div class="input-field">
						<i class="fas fa-envelope"></i>
						<input type="email" placeholder="Email" asp-for="Email" required />
					</div>
					<span asp-validation-for="Email" class="text-danger"></span>

					<div class="input-field">
						<i class="fas fa-lock"></i>
						<input type="password" placeholder="Password" asp-for="Password" required />
					</div>
					<span asp-validation-for="Password" class="text-danger"></span>

					<div class="input-field">
						<i class="fas fa-lock"></i>
						<input type="password" placeholder="Confirm Password" asp-for="ConfirmPassword" required />
					</div>
					<span asp-validation-for="ConfirmPassword" class="text-danger"></span>

					<input type="submit" class="btn" value="Sign up" />
				</form>
			</div>
		</div>

		<div class="panels-container">
			<div class="panel left-panel">
				<div class="content">
					<h3>Welcome Back !</h3>
					<p>
						Sign in with your email address and password.
						Don’t have an account?<strong style="color: gray;"> Create Account.</strong>
					</p>
					<button class="btn transparent" id="sign-up-btn">
						Sign up
					</button>
				</div>
			</div>
			<div class="panel right-panel">
				<div class="content">
					<h3>Welcome !</h3>
					<p>
						Create your account.
					</p>
					<button class="btn transparent" id="sign-in-btn">
						Sign in
					</button>
				</div>
			</div>
		</div>
	</div>

	<script>
		const sign_in_btn = document.querySelector("#sign-in-btn");
				const sign_up_btn = document.querySelector("#sign-up-btn");
				const container = document.querySelector(".container");

				sign_up_btn.addEventListener("click", () => {
					container.classList.add("sign-up-mode");
				});

				sign_in_btn.addEventListener("click", () => {
					container.classList.remove("sign-up-mode");
				});
				// //////////////////////////////////////////////////////////

		@if (TempData["ErrorMessage"] != null)
		{
			<text>
							alert('@TempData["ErrorMessage"]');
			</text>
		}
	</script>
</body>

